[Unit]
Description=Thermal Printer GUI (Flask)
Documentation=https://github.com/Cuzeth/thermal-printer
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/thermal-printer
EnvironmentFile=/home/pi/thermal-printer/.env
# --workers 1 is load-bearing: printer.py serializes USB via an in-process
# threading.Lock, and /api/m/print rate limiting lives in a process-local dict.
# Threads are fine (lock handles them); workers would race and double-print.
#
# Bind to 127.0.0.1 ONLY. The app relies on Tailscale's proxy to inject
# identity headers for tailnet gating — if the app listened on 0.0.0.0,
# anyone on the LAN could bypass auth by forging Tailscale-User-Login.
ExecStart=/home/pi/thermal-printer/.venv/bin/gunicorn --workers 1 --threads 2 --bind 127.0.0.1:${PORT} --access-logfile - --error-logfile - app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
