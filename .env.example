# thermal-printer config — Raspberry Pi deployment.
#
# Copy this to .env and fill in SECRET_KEY + ADMIN_TOKEN + OWNER_EMAIL.
# Everything else has sensible defaults in config.py; only override what
# you need.
#
#   cp .env.example .env
#   python3 -c "import secrets; print('SECRET_KEY=' + secrets.token_hex(32))"
#   python3 -c "import secrets; print('ADMIN_TOKEN=' + secrets.token_urlsafe(32))"

# ---- required in prod ----

# Flask session signing key. 64 hex chars.
SECRET_KEY=

# Bearer token for /api/admin/* AND every private console route
# (/api/hw/*, /api/print/*, /api/preview*, /api/image/*, /api/code/*).
# The main GUI reads it from here and inlines it in the page so you don't
# have to copy/paste. Keep it secret.
ADMIN_TOKEN=

# The email Cloudflare Access must have authenticated for private routes
# to open. Must match the address your Access policy allows (compared
# case-insensitively). Left empty, the console fails closed — every
# private route 403s.
OWNER_EMAIL=

# ---- network ----

# MUST be 127.0.0.1 in production. Only cloudflared may reach the app —
# the console gate trusts the Cf-Access-* identity headers, which is only
# safe because every request has to come through the tunnel (and its
# Access check) first. If the app listens on 0.0.0.0, anyone on the LAN
# can bypass the tunnel and forge the headers to access private routes.
HOST=127.0.0.1
PORT=5005

# ---- console gating ----

# Set to true for local dev without Cloudflare (python3 app.py on your
# Mac). Private routes check for the Cf-Access-* headers; this bypasses
# that check so the app works without the tunnel in front of it.
# NEVER set to true on the Pi.
DEV_BYPASS_ACCESS=false

# ---- printer hardware (defaults match an 80mm generic USB printer) ----

USB_VENDOR_ID=0x0483
USB_PRODUCT_ID=0x5720
# USB_OUT_EP=0x03
# USB_IN_EP=0x81

# Receipt width in characters at standard font. 32 for 58mm, 42 for 80mm.
RECEIPT_WIDTH=42

# Raster image width in pixels. 384 for 58mm, 576 for 80mm.
PRINTER_PIXEL_WIDTH=576

# ---- optional ----

# Where SQLite + DRY_RUN dumps live. Default: ./data relative to the repo.
# DATA_DIR=/home/pi/thermal-printer/data

# true = skip USB, dump ESC/POS bytes to data/last_print.bin instead.
# Leave false on the Pi; flip to true locally to iterate on layouts.
DRY_RUN=false

# ---- DO NOT SET ON THE PI ----

# FLASK_DEBUG=1 turns on the Werkzeug reloader + interactive debugger.
# The friends page (/m/*) is public at print.cuzeth.com, so the
# debugger = RCE. Dev-only, and only locally:  FLASK_DEBUG=1 python3 app.py
# FLASK_DEBUG=