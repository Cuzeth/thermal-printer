# Copy this to `.env` next to docker-compose.yml and fill in real values.
# `.env` is gitignored & dockerignored — secrets stay on the host.

# ---------- required in production ----------

# 32+ random bytes hex. Used to sign Flask session cookies.
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Long random token used to call /api/admin/* (the main GUI inlines it
# automatically, but you can also `curl -H "Authorization: Bearer ..."`).
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ---------- printer hardware (override only if your unit differs) ----------
# Defaults match the existing config.py.
# USB_VENDOR_ID=0x0483
# USB_PRODUCT_ID=0x5720
# USB_OUT_EP=0x03
# USB_IN_EP=0x81
# RECEIPT_WIDTH=42
# PRINTER_PIXEL_WIDTH=576

# ---------- runtime ----------
# DRY_RUN=false   # set true to skip USB and dump bytes to data/last_print.bin
